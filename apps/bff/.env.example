PORT=4000
WEB_ORIGIN=http://localhost:3000
FINAL_PLATFORM_API_URL=
FINAL_PLATFORM_API_KEY=
FINAL_PLATFORM_API_SECRET=
SESSION_SECRET=
FINALPAY_URL=
FINALPAY_SECRET=
FINALPAY_USER_PREFIX=
FINALPAY_TRANSACTION_PREFIX=ab
PAYMENTS_BRAND_NAME=alphabet
PAYMENTS_CALLBACK_BASE_URL=
PAYMENTS_TEST_MODE=
PAYMENTS_TEST_MAX_AMOUNT=50
# Development only. Ignored when NODE_ENV is production.
# Shows mock Card and Bank transfer methods. They stay pending and do not call FinalPay or move wallet funds.
# Live FinalPay stays off for *.finalpay.app and for Cosmoswin or Betfinal player and transaction prefixes.
PAYMENTS_MOCK_MODE=
# Support chat. Leave SUPPORT_AI_API_KEY empty until a provider is available.
# SUPPORT_AI_PROVIDER is openai or anthropic. openai defaults to gpt-4o-mini and https://api.openai.com/v1.
# anthropic defaults to claude-haiku-4-5 and https://api.anthropic.com.
# Human handoff shows only SUPPORT_EMAIL, SUPPORT_TELEGRAM_URL, SUPPORT_WHATSAPP_URL, and SUPPORT_HELPDESK_URL when set.
SUPPORT_AI_PROVIDER=openai
SUPPORT_AI_API_KEY=
SUPPORT_AI_MODEL=gpt-4o-mini
SUPPORT_AI_BASE_URL=https://api.openai.com/v1
SUPPORT_EMAIL=
SUPPORT_TELEGRAM_URL=
SUPPORT_WHATSAPP_URL=
SUPPORT_HELPDESK_URL=
# Public Telegram bot id (digits only). This is not the bot token.
# Platform verifies the login widget. Leave empty to hide Telegram sign-in.
# The bot domain configured in BotFather must match WEB_ORIGIN.
TELEGRAM_BOT_ID=

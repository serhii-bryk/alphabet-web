PORT=4000
WEB_ORIGIN=http://localhost:3000
FINAL_PLATFORM_API_URL=
FINAL_PLATFORM_API_KEY=
FINAL_PLATFORM_API_SECRET=
SESSION_SECRET=
FINALPAY_URL=
FINALPAY_SECRET=
FINALPAY_USER_PREFIX=
FINALPAY_TRANSACTION_PREFIX=ab
PAYMENTS_BRAND_NAME=alphabet
PAYMENTS_CALLBACK_BASE_URL=
PAYMENTS_TEST_MODE=
PAYMENTS_TEST_MAX_AMOUNT=50
# Development only. Ignored when NODE_ENV is production.
# Shows mock Card and Bank transfer methods. They stay pending and do not call FinalPay or move wallet funds.
# Live FinalPay stays off for *.finalpay.app and for Cosmoswin or Betfinal player and transaction prefixes.
PAYMENTS_MOCK_MODE=
# Support chat. Real model calls stay off until AI_CHAT_ENABLED=true.
# Use OPENAI_API_KEY on the server only. Do not put it in a NEXT_PUBLIC variable.
# The default model is gpt-4o-mini. Image, audio, browsing, and code tools are not used.
# These limits complement OpenAI organization and project billing controls. Set those too.
# Live calls are refused when NODE_ENV=production because the budget file is local to one machine.
AI_CHAT_ENABLED=false
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4o-mini
AI_CHAT_BASE_URL=https://api.openai.com/v1
AI_CHAT_DAILY_BUDGET_USD=1
AI_CHAT_TOTAL_BUDGET_USD=5
AI_CHAT_SESSION_LIMIT=10
AI_CHAT_HOURLY_LIMIT=10
AI_CHAT_MAX_MESSAGE_CHARS=500
AI_CHAT_MAX_OUTPUT_TOKENS=250
AI_CHAT_MAX_INPUT_TOKENS=2000
AI_CHAT_MAX_CONCURRENT=2
AI_CHAT_TIMEOUT_MS=8000
AI_CHAT_MAX_HISTORY=6
AI_CHAT_INPUT_USD_PER_MILLION=0.15
AI_CHAT_OUTPUT_USD_PER_MILLION=0.60
SUPPORT_EMAIL=
SUPPORT_TELEGRAM_URL=
SUPPORT_WHATSAPP_URL=
SUPPORT_HELPDESK_URL=
# Public Telegram bot id (digits only). This is not the bot token.
# Platform verifies the login widget. Leave empty to hide Telegram sign-in.
# The bot domain configured in BotFather must match WEB_ORIGIN.
TELEGRAM_BOT_ID=
